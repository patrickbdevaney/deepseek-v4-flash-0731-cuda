build/
*.o
*.bin
cache/
.flywheel_cycles/
.flywheel_last_run.*
.flywheel_quarantine/
# evidence/ is deliberately NOT ignored — see the archive step in scripts/flywheel.sh
.flywheel_selftest.txt
.flywheel_failstreak
.flywheel_commit_msg

# runtime state, never tracked: a committed stop flag silently disables the loop on checkout
FLYWHEEL_STOP
.flywheel_audited
.flywheel_commit_msg
.flywheel_last_run.jsonl

# python bytecode from the analysis tools
__pycache__/
*.pyc

# Perf corpus: the SQLite warehouse is a pure function of evidence/evals/*.jsonl and is rebuilt
# by tools/perf_ingest.py, so committing it would only create merge conflicts on a binary.
# The /metrics time series IS primary evidence and is committed.
evidence/perf/perf.sqlite
evidence/perf/refresh.log

# Generation traces: benchmark PROMPTS paired with model completions. Publishing these
# contaminates the benchmarks they came from -- including the ones this repo reports scores on.
# Rebuilt on demand by tools/trace_export.py from the eval records, so nothing is lost by not
# tracking them. The README explaining the policy IS tracked.
evidence/traces/*.jsonl
evidence/traces/MANIFEST.*.json

# BFCL's own eval package, installed isolated so its pinned numpy / faiss / sentence-transformers
# never touch the environment the rest of this repo runs in. Recreate with:
#   python3 -m venv .venv-bfcl && .venv-bfcl/bin/pip install --no-deps bfcl_eval==2026.3.23
#   .venv-bfcl/bin/pip install mpmath==1.3.0 tree_sitter==0.21.3 tree-sitter-java==0.21.0 \
#       tree-sitter-javascript==0.21.4 filelock==3.20.0 tenacity pydantic python-dotenv requests tqdm overrides
.venv-bfcl/
build/dsv4-server.staged
build/dsv4-server.prev.*

# Upstream SGLang clone, pulled 2026-08-19 as a kernel reference (DeepSeek-V4 top-k,
# lightning indexer, mega_moe_pre_dispatch). 152 MB, Apache-2.0, NOT ours to vendor.
# eval_land.sh runs a bare `git add -A`, so without this the next landing commit swallows it.
sglangsrc/

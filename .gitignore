build/
*.o
*.bin
cache/
.flywheel_cycles/
.flywheel_last_run.*
.flywheel_quarantine/
# evidence/ is deliberately NOT ignored — see the archive step in scripts/flywheel.sh
.flywheel_selftest.txt
.flywheel_failstreak
.flywheel_commit_msg

# runtime state, never tracked: a committed stop flag silently disables the loop on checkout
FLYWHEEL_STOP
.flywheel_audited
.flywheel_commit_msg
.flywheel_last_run.jsonl

# python bytecode from the analysis tools
__pycache__/
*.pyc

# Perf corpus: the SQLite warehouse is a pure function of evidence/evals/*.jsonl and is rebuilt
# by tools/perf_ingest.py, so committing it would only create merge conflicts on a binary.
# The /metrics time series IS primary evidence and is committed.
evidence/perf/perf.sqlite
evidence/perf/refresh.log

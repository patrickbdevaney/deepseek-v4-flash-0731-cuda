def main():
    data = list(map(int, sys.stdin.buffer.read().split()))
    if not data:
        return
    N = data[0]
    tree = [0] * (N + 1)
    for i in range(1, N + 1):
        tree[i] = i & -i
    ans = [0] * N
    highest = 1 << (N.bit_length() - 1)
    for i in range(N, 0, -1):
        k = data[i]
        idx = 0
        bit = highest
        while bit:
            nxt = idx + bit
            if nxt <= N and tree[nxt] < k:
                idx = nxt
                k -= tree[nxt]
            bit >>= 1
        pos = idx + 1
        ans[pos - 1] = i
        j = pos
        while j <= N:
            tree[j] -= 1
            j += j & -j
    sys.stdout.write(' '.join(map(str, ans)) + '\n')

if __name__ == '__main__':
    main()

from bisect import bisect_left

def main():
    data = list(map(int, sys.stdin.buffer.read().split()))
    if not data:
        return

    N = data[0]
    X = data[1]

    groups = [[] for _ in range(3)]
    total = [0, 0, 0]

    idx = 2
    for _ in range(N):
        v = data[idx] - 1
        a = data[idx + 1]
        c = data[idx + 2]
        idx += 3
        groups[v].append((c, a))
        total[v] += a

    bests = []

    for v in range(3):
        dp = [-1] * (X + 1)
        dp[0] = 0

        for w, val in groups[v]:
            for j in range(X, w - 1, -1):
                prev = dp[j - w]
                if prev != -1:
                    nv = prev + val
                    if nv > dp[j]:
                        dp[j] = nv

        best = [0] * (X + 1)
        cur = 0
        for i in range(X + 1):
            if dp[i] > cur:
                cur = dp[i]
            best[i] = cur

        bests.append(best)

    def feasible(T):
        total_cost = 0
        for best in bests:
            pos = bisect_left(best, T)
            if pos > X:
                return False
            total_cost += pos
            if total_cost > X:
                return False
        return True

    low = 0
    high = min(total)
    ans = 0

    while low <= high:
        mid = (low + high) // 2
        if feasible(mid):
            ans = mid
            low = mid + 1
        else:
            high = mid - 1

    print(ans)

if __name__ == "__main__":
    main()

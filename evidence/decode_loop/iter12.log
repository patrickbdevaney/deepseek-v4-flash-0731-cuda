nsrc/decode.cu:772:        // the WORKLOAD, not of the model: on realistic prompts BLK=6 beat 5 on 4 of 4, while the\nsrc/decode.cu:775:        // could not use. `adaptK` already adapts the width WITHIN a block from the draft's own\nsrc/decode.cu:784:        // BLK=8 is NOT reachable by this controller and that is deliberate: F94 measured tau FALLING\nsrc/decode.cu:786:        // 1..BLK-1 and a wider noise field degrades proposals the head was getting right. The head\nsrc/decode.cu:788:        static const bool adaptblk = getenv(\"DSV4_ADAPTBLK\") != nullptr;\nsrc/decode.cu:790:        int BLK = adaptblk ? BLK0 : BLK0;          // BLK is now MUTABLE when adaptblk is on\nsrc/decode.cu:792:        // adaptK = 0 means fixed width, i.e. exactly the previous behaviour. The default comes from\nsrc/decode.cu:799:        // the one it was fitted on. A NEGATIVE adaptK now means \"fixed width\", e.g. `5:1:-1:2` runs\nsrc/decode.cu:802:        const float adaptK = adaptSweep[bsi] < 0.f ? 0.f\nsrc/decode.cu:1047:            std::vector<int> pbid(BLK,DSPARK_NOISE_TID), poo(BLK+1); std::vector<float> pmarg(BLK,0.f);\nsrc/decode.cu:1056:                pbid.assign(BLK,DSPARK_NOISE_TID); pbid[0]=pcur;\nsrc/decode.cu:1057:                CU(cudaMemcpy(dbid,pbid.data(),BLK*4,cudaMemcpyHostToDevice));\nsrc/decode.cu:1058:                k_embed<<<((size_t)BLK*d+255)/256,256>>>(xemb,emb,dbid,BLK,d);\nsrc/decode.cu:1059:                k_hc_expand<<<((size_t)BLK*hc*d+255)/256,256>>>(xa,xemb,BLK,hc,d); CU(cudaDeviceSynchronize());\nsrc/decode.cu:1070:                if(dmp){ uint32_t meta[3]={(uint32_t)t,(uint32_t)pcur,(uint32_t)BLK};\nsrc/decode.cu:1074:                dump(\"after_embed\", pc, (size_t)BLK*hc*d);\nsrc/decode.cu:1077:                        blk_cos+(size_t)pctx*hf, blk_sin+(size_t)pctx*hf, BLK,WINDOW,HC_SINKHORN_ITERS,EPS);\nsrc/decode.cu:1080:                    char tg[24]; snprintf(tg,sizeof tg,\"after_block%d\",st); dump(tg, pc, (size_t)BLK*hc*d); }\nsrc/decode.cu:10
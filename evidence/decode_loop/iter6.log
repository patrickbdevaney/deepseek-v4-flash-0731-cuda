{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01EKBS32psZzQLcyA8E5Swnz","type":"tool_result","content":"88\t// change still matches the original selection sort. The reference is worth more than the twelve\n89\t// lines it costs to keep it correct.\n90\tstatic inline size_t topk_scan_smem_optin(const void* fn, int n, const char* what){\n91\t    const size_t need = topk_scan_smem(n);\n92\t    // Drain the error slot BEFORE the launch so `topk_smem_launch_check` below can attribute what\n93\t    // it finds to THIS launch and nothing else. Draining silently would hide someone else's fault,\n94\t    // so a pre-existing error is reported here and named as pre-existing -- which is more than the\n95\t    // previous behaviour (dsync warns only, and is a no-op entirely while the arena is on).\n96\t    // Two host-side TLS reads per fallback launch, against a kernel that takes 30-700 us.\n97\t    { cudaError_t pre = cudaGetLastError();\n98\t      if(pre != cudaSuccess) fprintf(stderr, \"[topk-smem] pre-existing CUDA error before %s: %s\\n\",\n99\t                                     what, cudaGetErrorString(pre)); }\n100\t    static int lim_default = 0, lim_optin = 0;\n101\t    if(!lim_default){\n102\t        int dev = 0; cudaGetDevice(&dev);\n103\t        cudaDeviceGetAttribute(&lim_default, cudaDevAttrMaxSharedMemoryPerBlock,      dev);\n104\t        cudaDeviceGetAttribute(&lim_optin,   cudaDevAttrMaxSharedMemoryPerBlockOptin, dev);\n105\t        if(!lim_default) lim_default = 48*1024;                       // query failed; assume the floor\n106\t        if(lim_optin < lim_default) lim_optin = lim_default;\n107\t    }\n108\t    if(need <= (size_t)lim_default) return need;                      // the whole reachable regime\n109\t    if(need > (size_t)lim_optin){\n110\t        fprintf(stderr, \"[topk-smem] FATAL %s wants %zu B of dynamic shared memory for T=%d, but this \"\n111\t                \"device's opt-in maximum is %d B (T <= %d, context <= %d at ratio 4). Refusing to \"\n112\t                \"issue a launch that would fail and leave the output buffer untouched. Use the radix \"\n113\t                \"select (DSV4_TOPK_RADIX=1, the default), which needs none.\\n\",\n114\t                what, need, n, lim_optin, (int)(lim_optin/4) - 3, ((int)(lim_optin/4) - 3) * 4);\n115\t        fflush(stderr); abort();\n116\t    }\n117\t    static const void* done[8]; static int ndone = 0;                 // one opt-in per kernel, ever\n118\t    for(int i = 0; i < ndone; ++i) if(done[i] == fn) return need;\n119\t    cudaError_t e = cudaFuncSetAttribute(fn, cudaFuncAttributeMaxDynamicSharedMemorySize, lim_optin);\n120\t    if(e != cudaSuccess){\n121\t        fprintf(stderr, \"[topk-smem] FATAL cudaFuncSetAttribute(%s, MaxDynamicSharedMemorySize, %d) \"\n122\t                \"failed: %s\\n\", what, lim_optin, cudaGetErrorString(e));\n123\t        fflush(stderr); abort();\n124\t    }\n125\t    if(ndone < 8) done[ndone++] = fn;\n126\t    fprintf(stderr, \"[topk-smem] %s opted in to %d B dynamic shared memory (needed %zu B at T=%d; \"\n127\t            \"default limit is %d B)\\n\", what, lim_optin, need, n, lim_default);\n128\t    fflush(stderr);\n129\t    return need;\n130\t}\n131\t#define TOPK_SMEM(fn, n) topk_scan_smem_optin((const void*)(fn), (n), #fn)\n132\t\n133\t// A launch that asks for too much dynamic shared memory fails at LAUNCH, and the next\n134\t// cudaStreamSynchronize returns success (measured, see above) -- so a sync-based check cannot catch\n135\t// it. This is the host-side check that can: it is a pure host call, adds no sync, and turns a\n136\t// silently-wrong answer into a stopped process. Placed after every launch that requests a\n137\t// context-sized shared allocation.\n138\tstatic inline void topk_smem_launch_check(const char* what, int n, size_t bytes){\n139\t    cudaError_t e = cudaGetLastError();\n140\t    if(e == cudaSuccess) return;\n141\t    fprintf(stderr, \"[topk-smem] FATAL launch
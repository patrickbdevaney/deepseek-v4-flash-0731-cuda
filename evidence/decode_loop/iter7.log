4:    float acc[PER];\n185:    #pragma unroll\n186:    for (int r = 0; r < PER; ++r) acc[r] = 0.f;\n187:    float run_max = -1e30f, run_sum = 0.f;\n188:\n189:    if (topk > 0) { int i0 = ip[0];\n190:        if (i0 >= 0) { const float4* src = (const float4*)(kvb + (size_t)i0 * d);\n191:                       for (int v = threadIdx.x; v < NV; v += nthr) ((float4*)sh[0])[v] = src[v]; } }\n192:    __syncthreads();\n193:\n194:    for (int t = 0; t < topk; ++t) {\n195:        const int idx = ip[t];\n196:        const int cur = t & 1;\n197:        if (t + 1 < topk) { int i1 = ip[t + 1];\n198:            if (i1 >= 0) { const float4* src = (const float4*)(kvb + (size_t)i1 * d);\n199:                           for (int v = threadIdx.x; v < NV; v += nthr) ((float4*)sh[cur ^ 1])[v] = src[v]; } }\n200:        if (idx >= 0) {","stderr":"","interrupted":false,"isImage":false,"noOutputExpected":false}}

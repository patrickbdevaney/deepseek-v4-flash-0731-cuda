ls/block.cu kernels/compressor.cu \\\n  kernels/indexer.cu kernels/compressed_attn.cu kernels/compressed_block.cu kernels/tc_moe_gemm.cu \\\n  kernels/tc_fp8_gemm.cu kernels/mla_decode.cu kernels/compressed_decode.cu kernels/block_decode.cu kernels/dscratch.cu kernels/dprof.cu kernels/dspark_real.cu kernels/dspark_attn.cu kernels/dspark.cu kernels/nvfp4_dense.cu \\\n  -o build/decode\necho \"built build/decode\"","stderr":"","interrupted":false,"isImage":false,"noOutputExpected":false}}

{"type":"assistant","message":{"model":"claude-opus-5","id":"msg_011CeDbnDffDFhNaKByp1A8m","type":"message","role":"assistant","content":[{"type":"tool_use","id":"toolu_01MrjovFudG1mGZiHGX95mKE","name":"Bash","input":{"command":"cd /home/patrickd/deepseek-v4-flash-0731-cuda\npython3 - <<'PY' | tee evidence/decode_loop/fit_1p0_paired.txt\nimport json,glob,statistics as st\n\ndef load(d):\n    o={}\n    for f in glob.glob(f'evidence/decode_loop/{d}/*.jsonl'):\n        for line in open(f):\n            r=json.loads(line); t=r['timings']; u=r['usage']\n            o[r['id']]=dict(fwd=t['decode_ms']/u['completion_tokens']*t['tokens_per_verify'],\n                            tau=t['tokens_per_verify'], w=r['spec_profile']['mean_width'],\n                            ctx=u['prompt_tokens'], tps=t['tokens_per_second'])\n    return o\nA,B=load('fit_1p0_base'),load('fit_1p0_cache')\n\nprint(\"PAIRED A/B — ladder 1.0, incremental main-KV. Each rep compared to the SAME rep of the\")\nprint(\"other arm. Legs are paired by construction: tau and mean_width match rep-for-rep on every\")\nprint(\"sweep point, so the pairing removes verify-width variance instead of averaging over it.\")\nprint()\nprint(f\"{'point':16s} {'n':>2s} {'ctx':>6s} {'before':>8s} {'after':>8s} {'d med':>8s} {'d min':>7s} {'d max':>7s} {'speedup':>8s} {'tau ok':>7s}\")\ngroups={}\nfor k in A:\n    if k in B: groups.setdefault(k.rsplit('-r',1)[0],[]).append(k)\ndef key(g):\n    return (0 if g.startswith('sweep') else 1, -int(g.split('-t')[1]))\nfor g in sorted(groups,key=key):\n    ks=sorted(groups[g]); ds=[]; taus=[]\n    for k in ks:\n        ds.append(B[k]['fwd']-A[k]['fwd'])\n        taus.append(abs(A[k]['tau']-B[k]['tau'])<1e-9 and abs(A[k]['w']-B[k]['w'])<1e-9)\n    ctx=A[ks[0]]['ctx']\n    bef=st.median([A[k]['fwd'] for k in ks]); aft=bef+st.median(ds)\n    print(f\"{g:16s} {len(ks):2d} {ctx:6d} {bef:8.2f} {aft:8.2f} {st.median(ds):8.2f} \"\n          f\"{min(ds):7.2f} {max(ds):7.2f} {bef/aft:7.3f}x {sum
lim, topkc, -1e30f, S);\n    for(int k=threadIdx.x;k<topkc;k+=TOPK_RADIX_NT){ int b=out[k]; out[k] = (b<0)? -1 : nwin+b; }\n}\n''' + anchor\nassert anchor in s\ns = s.replace(anchor, new_ver, 1)\n\n# --- k_topk_masked radix twin ---\nanchor2 = '''__global__ void k_comb_join(int* comb, const int* win, const int* sel, int wtop, int topk_c){'''\nnew_msk = '''__global__ void k_topk_masked_rx(int* out, const float* score, int Tmax, int topk, int winmax){\n    if(blockIdx.x) return;\n    __shared__ TopkRadixSmem S;\n    topk_radix_select<TOPK_RADIX_NT>(out, score, Tmax, topk, -1e29f, S);   // NOTE the -1e29f floor, verbatim\n    for(int k=threadIdx.x;k<topk;k+=TOPK_RADIX_NT){ int b=out[k]; out[k] = (b<0)? -1 : winmax+b; }\n}\n''' + anchor2\nassert anchor2 in s\ns = s.replace(anchor2, new_msk, 1)\n\n# --- launch sites ---\no1 = '''    k_topk_decode<<<1,32,topk_scan_smem(Tn),stream>>>(dtop, iscore, Tn, topk, coff);'''\nn1 = '''    if(topk_radix_on() && topk<=TOPK_RADIX_CAP) k_topk_decode_rx<<<1,TOPK_RADIX_NT,0,stream>>>(dtop, iscore, Tn, topk, coff);\n    else                                       k_topk_decode<<<1,32,topk_scan_smem(Tn),stream>>>(dtop, iscore, Tn, topk, coff);'''\nassert o1 in s; s = s.replace(o1, n1, 1)\n\no2 = '''    k_topk_verify<<<K,32,topk_scan_smem(Tf),stream>>>(dtop, iscore, K, Tf, topkc, pos, ratio, coff);   // device top-k (no D2H sync)'''\nn2 = '''    if(topk_radix_on() && topkc<=TOPK_RADIX_CAP) k_topk_verify_rx<<<K,TOPK_RADIX_NT,0,stream>>>(dtop, iscore, K, Tf, topkc, pos, ratio, coff);\n    else                                         k_topk_verify<<<K,32,topk_scan_smem(Tf),stream>>>(dtop, iscore, K, Tf, topkc, pos, ratio, coff);   // device top-k (no D2H sync)'''\nassert o2 in s; s = s.replace(o2, n2, 1)\n\no3 = '''    k_topk_masked<<<1,32,topk_scan_smem(Tmax),stream>>>(sel,isc,Tmax,topk_c,winmax); dprobe(stream);'''\nn3 = '''    if(topk_radix_on() && topk_c<=TOPK_RADIX_CAP) k_topk_masked_rx<<<1,TOPK_RADIX_NT,0,stream>>>(sel,isc,Tmax,topk_c,win